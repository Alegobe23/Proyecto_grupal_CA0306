longtable = TRUE,
align = c("l", "r", "r")
) %>%
kableExtra::kable_styling(
latex_options = c("repeat_header"),
full_width = FALSE,
position = "center",
font_size = 10
)
datos_analisis <- datos_modificados %>%
select(-Date_lapse) %>%
group_by(categoria) %>%
mutate(
Length = ifelse(
is.na(Length),
median(Length, na.rm = TRUE),
Length
)
) %>%
ungroup() %>%
filter(!is.na(Type_fuel))
variables_modelacion <- c(
"ID",
"categoria",
"Area",
"edad",
"Seniority",
"antiguedad_licencia",
"edad_vehiculo",
"Power",
"Value_vehicle",
"Weight",
"Length",
"N_claims_year",
"Cost_claims_year",
"N_claims_history",
"R_Claims_history"
)
datos_modelacion <- datos_analisis %>%
select(all_of(variables_modelacion))
tabla_frecuencia_severidad <- datos_modelacion %>%
summarise(
`Promedio de siniestros anuales` = mean(N_claims_year, na.rm = TRUE),
`Mediana de siniestros anuales` = median(N_claims_year, na.rm = TRUE),
`Máximo de siniestros anuales` = max(N_claims_year, na.rm = TRUE),
`% sin siniestros anuales` = mean(N_claims_year == 0, na.rm = TRUE) * 100,
`Costo promedio anual` = mean(Cost_claims_year, na.rm = TRUE),
`Costo mediano anual` = median(Cost_claims_year, na.rm = TRUE),
`Costo máximo anual` = max(Cost_claims_year, na.rm = TRUE),
`% con costo anual igual a 0` = mean(Cost_claims_year == 0, na.rm = TRUE) * 100
) %>%
pivot_longer(
cols = everything(),
names_to = "Indicador",
values_to = "Valor"
) %>%
mutate(Valor = round(Valor, 2))
knitr::kable(
tabla_frecuencia_severidad,
caption = "Resumen descriptivo de frecuencia y severidad de siniestros",
booktabs = TRUE
) %>%
kableExtra::kable_styling(
full_width = FALSE,
position = "center",
font_size = 9,
latex_options = c("hold_position")
)
variables_relevantes <- c(
"edad",
"Seniority",
"antiguedad_licencia",
"N_claims_year",
"Cost_claims_year",
"N_claims_history",
"R_Claims_history",
"edad_vehiculo",
"Power",
"Value_vehicle",
"Weight",
"Length"
)
tabla_descriptiva <- datos_modelacion %>%
select(all_of(variables_relevantes)) %>%
pivot_longer(
cols = everything(),
names_to = "Variable",
values_to = "Valor"
) %>%
group_by(Variable) %>%
summarise(
n_validos = sum(!is.na(Valor)),
n_nulos = sum(is.na(Valor)),
minimo = min(Valor, na.rm = TRUE),
Q1 = quantile(Valor, 0.25, na.rm = TRUE),
media = mean(Valor, na.rm = TRUE),
mediana = median(Valor, na.rm = TRUE),
Q3 = quantile(Valor, 0.75, na.rm = TRUE),
maximo = max(Valor, na.rm = TRUE),
desv_estandar = sd(Valor, na.rm = TRUE),
.groups = "drop"
) %>%
mutate(
across(
c(minimo, Q1, media, mediana, Q3, maximo, desv_estandar),
~ round(., 3)
)
)
knitr::kable(
tabla_descriptiva,
caption = "Estadística descriptiva de variables cuantitativas relevantes",
booktabs = TRUE,
longtable = TRUE
) %>%
kableExtra::kable_styling(
latex_options = c("repeat_header", "scale_down"),
full_width = FALSE,
position = "center",
font_size = 8
)
tabla_ceros_umbral <- datos_modelacion %>%
summarise(
`Registros sin siniestros anuales` = sum(N_claims_year == 0, na.rm = TRUE),
`% sin siniestros anuales` = mean(N_claims_year == 0, na.rm = TRUE) * 100,
`Registros con costo igual a 0` = sum(Cost_claims_year == 0, na.rm = TRUE),
`% con costo igual a 0` = mean(Cost_claims_year == 0, na.rm = TRUE) * 100,
`Registros con costo igual a 900` = sum(Cost_claims_year == 900, na.rm = TRUE),
`% con costo igual a 900` = mean(Cost_claims_year == 900, na.rm = TRUE) * 100,
`Registros con costo mayor a 900` = sum(Cost_claims_year > 900, na.rm = TRUE),
`% con costo mayor a 900` = mean(Cost_claims_year > 900, na.rm = TRUE) * 100
) %>%
pivot_longer(
cols = everything(),
names_to = "Indicador",
values_to = "Valor"
) %>%
mutate(Valor = round(Valor, 2))
knitr::kable(
tabla_ceros_umbral,
caption = "Concentración de ceros y comportamiento respecto al umbral de 900 euros",
booktabs = TRUE
) %>%
kableExtra::kable_styling(
full_width = FALSE,
position = "center",
font_size = 9,
latex_options = c("hold_position")
)
variables_outliers <- c(
"edad",
"Seniority",
"antiguedad_licencia",
"N_claims_year",
"Cost_claims_year",
"N_claims_history",
"R_Claims_history",
"edad_vehiculo",
"Power",
"Value_vehicle",
"Weight",
"Length"
)
tabla_outliers <- datos_modelacion %>%
select(all_of(variables_outliers)) %>%
pivot_longer(
cols = everything(),
names_to = "Variable",
values_to = "Valor"
) %>%
group_by(Variable) %>%
summarise(
Q1 = quantile(Valor, 0.25, na.rm = TRUE),
Q3 = quantile(Valor, 0.75, na.rm = TRUE),
IQR = Q3 - Q1,
limite_inferior = Q1 - 1.5 * IQR,
limite_superior = Q3 + 1.5 * IQR,
total_outliers = sum(
Valor < limite_inferior | Valor > limite_superior,
na.rm = TRUE
),
porcentaje_outliers = round(total_outliers / sum(!is.na(Valor)) * 100, 2),
.groups = "drop"
) %>%
mutate(
across(where(is.numeric), ~ round(., 3))
)
knitr::kable(
tabla_outliers,
caption = "Detección de valores atípicos mediante el método IQR",
booktabs = TRUE,
longtable = TRUE
) %>%
kableExtra::kable_styling(
latex_options = c("repeat_header", "scale_down"),
full_width = FALSE,
position = "center",
font_size = 8
)
tabla_categoria <- datos_modelacion %>%
group_by(categoria) %>%
summarise(
`Cantidad de registros` = n(),
`% del total` = round(n() / nrow(datos_modelacion) * 100, 2),
`Promedio de siniestros` = round(mean(N_claims_year, na.rm = TRUE), 3),
`% sin siniestros` = round(mean(N_claims_year == 0, na.rm = TRUE) * 100, 2),
`Costo promedio` = round(mean(Cost_claims_year, na.rm = TRUE), 2),
`Costo mediano` = round(median(Cost_claims_year, na.rm = TRUE), 2),
.groups = "drop"
)
knitr::kable(
tabla_categoria,
caption = "Frecuencia y severidad de siniestros según tipo de vehículo",
booktabs = TRUE
) %>%
kableExtra::kable_styling(
full_width = FALSE,
position = "center",
